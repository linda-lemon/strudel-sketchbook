// Switch Angel tutorial: Chopping Breaks & Samples
// 2026-04-14

// Breakcore/Jungle

const ratchet = register('ratchet', (pat) => pat.sometimes(ply(2)))

setGainCurve(x=>Math.pow(x, 2))

samples('github:switchangel/breaks')
samples('github:switchangel/pad')

setCps(170/60/4)

$: s("breaks/2")
  .n(0)
  .fit()
  // scrub() allows us to grab a little window of the track
  // rib() constrains the randomness of scrub() allowing us to 
  // play a section over and over again
  .scrub(irand(16).div(16).seg(8)) //random 16th note sections
  .rib("<5 <11 15>>", 2) // can pattern as well
  //stutter effect, idiomatic of breakcore
  .almostNever(ply("2|3|4")) //randomly choose between repeating 2, 3 or 4 times
  .orbit(2) // TODO: investigate how orbit routing works
  ._scope()
// white noise hi-hat
$: s("white!8").decay(.08).gain(.45)
  .almostNever(ply("2|4"))

// pads - breakcore has min 7ths, 9ths, 11ths

// store "scrubs" you like in an array
const chops =  [
  ".2@3 .4", //specific chops
  ".1@3 .7 .5 .05@3",
  ".13 .35@3",
  rand.seg(8) .rib(0, 1), //or 8 random segments, ribboned
  rand.seg(8).rib(3, 1) //ribboned again!
]

$: s("swpad")
  .n(2) //index for different pads 
  //pass in array into scrub, with pick() function
  .scrub(pick(chops, "<<0@2 3@2 1 4>@3 [1 3]>"))
  .gain("<1.2@3 1>")
  .room(1).roomsize(3) //reverb
  .phaser(.4)
  .note("<c2@3 c3 f1@3 f2>") //switch octaves
 
// bass with low pass filter
$: s("supersaw").note("<c2@3 g#1 f2@3 g#1>").seg("<1@3 8>") //8th note repeated notes
   .lpf(300).gain(1.1)

 
 